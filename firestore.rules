rules_version = '2';

// Single-owner app: no public signup, no multi-tenant data model.
// Firebase Auth is still required for client reads/writes so the
// database isn't open to the internet. Cloud Functions use the Admin
// SDK and bypass these rules entirely (that's where quest generation
// and Zargon's turn logic write).
//
// TODO: once the owner's Firebase Auth account exists, lock this down
// further to request.auth.uid == '<owner-uid>' instead of just
// "signed in."
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
